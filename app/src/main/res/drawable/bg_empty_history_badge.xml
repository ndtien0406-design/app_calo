<?xml version="1.0" encoding="utf-8"?>
<!-- Huy hiệu 64dp cho trạng thái trống Lịch sử: khối nổi vát sáng + icon Lucide rotate-ccw-clock -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="64dp"
        android:height="64dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_rim_top" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:width="64dp"
        android:height="63dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/badge_grad_bottom"
                android:startColor="@color/badge_grad_top"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:width="28dp"
        android:height="28dp"
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:tint="@color/proto_primary"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="#00000000"
                android:pathData="M3,12a9,9 0,1 0,9 -9a9.75,9.75 0,0 0,-6.74 2.74L3,8"
                android:strokeWidth="2"
                android:strokeColor="#FF000000"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <path
                android:fillColor="#00000000"
                android:pathData="M3,3v5h5"
                android:strokeWidth="2"
                android:strokeColor="#FF000000"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <path
                android:fillColor="#00000000"
                android:pathData="M12,7v5l4,2"
                android:strokeWidth="2"
                android:strokeColor="#FF000000"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </vector>
    </item>
</layer-list>

