<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ Hero Tổng quan 3 lớp (Uiverse 135° Mesh Gradient + Radial Glow Orb + CT999 Top Rim Light 1dp) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_hero" />
            <solid android:color="@color/card_rim_top" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_hero" />
            <gradient
                android:angle="315"
                android:centerColor="@color/hero_under_center"
                android:endColor="@color/hero_under_end"
                android:startColor="@color/hero_under_start"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_hero" />
            <gradient
                android:centerX="0.85"
                android:centerY="0.15"
                android:endColor="@android:color/transparent"
                android:gradientRadius="160dp"
                android:startColor="@color/hero_orb_under"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
