<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kiểu dùng chung cho cả giao diện sáng và tối (màu lấy qua thuộc tính theme). -->

    <!-- Nhãn phía trên ô nhập (bản xem thử: chữ đậm nhỏ). -->
    <style name="Widget.CaloTrack.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Tiêu đề nhóm (Cài đặt): chữ nhỏ, màu nhấn, nằm ngoài thẻ. -->
    <style name="Widget.CaloTrack.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_4</item>
        <item name="android:layout_marginBottom">@dimen/space_8</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Số liệu calo: chữ số đều độ rộng (tabular) để các con số không nhảy khi đổi giá trị. -->
    <style name="Widget.CaloTrack.Number" parent="">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.CaloTrack.Number.Hero">
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Đơn vị "kcal" đứng cạnh số. -->
    <style name="Widget.CaloTrack.Unit" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/space_4</item>
        <item name="android:text">@string/unit_kcal</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Nút chỉ có biểu tượng: vùng chạm 48dp, màu trung tính. -->
    <style name="Widget.CaloTrack.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Bottom nav kiểu bản xem thử: icon nằm trong pill, pill active = secondary-container. -->
    <style name="Widget.CaloTrack.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.CaloTrack.BottomNavActiveIndicator</item>
    </style>

    <style name="Widget.CaloTrack.BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorSecondaryContainer</item>
    </style>
</resources>

