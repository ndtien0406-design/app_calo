<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Tầng 0: Nền trang Ambient Radial Mesh Glow + Micro Dot-Matrix -->
    <com.ndtien.calotrack.UiverseAmbientBgView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Cụm trung tâm: Vòng xoay kép Uiverse + Sóng xung Sonar + Logo + Thương hiệu -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="188dp"
            android:layout_height="188dp">

            <com.ndtien.calotrack.UiverseOrbitView
                android:id="@+id/orbit_loader"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/iv_splash_logo"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/splash_tagline"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Cụm đáy màn hình: Thanh 5 cột sóng Uiverse Wave Bars + trạng thái khởi tạo -->
    <LinearLayout
        android:id="@+id/layout_splash_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="vertical">

        <com.ndtien.calotrack.UiverseWaveBarsView
            android:id="@+id/wave_bars_loader"
            android:layout_width="88dp"
            android:layout_height="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.03"
            android:text="@string/splash_loading"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
